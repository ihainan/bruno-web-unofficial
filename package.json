{
  "name": "bruno-web",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial: run the Bruno API client in a browser, backed by the unmodified Bruno main-process code on Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihainan/bruno-web.git"
  },
  "homepage": "https://github.com/ihainan/bruno-web",
  "bugs": {
    "url": "https://github.com/ihainan/bruno-web/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "BRUNO_WEB_DATA=./data BRUNO_WEB_AUTH=none node server/index.js",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test -c test/e2e/playwright.config.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
